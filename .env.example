# Required: Anthropic API key, used for memory extraction, Hey Kivi tool-use
# orchestration, and answer synthesis.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model used for cheap, high-volume background work (memory extraction/dedup).
KIVI_EXTRACTION_MODEL=claude-haiku-4-5-20251001

# Model used for Hey Kivi orchestration (tool selection) and answer synthesis.
KIVI_ORCHESTRATION_MODEL=claude-sonnet-4-6

# Path to the SQLite database file.
KIVI_DB_PATH=./kivi.db

# Local embedding model (sentence-transformers). No API key needed.
KIVI_EMBEDDING_MODEL=all-MiniLM-L6-v2
